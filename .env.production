# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# 
# Copy this as reference for Render and Vercel deployment
# DO NOT commit this file - set values in dashboard environment variables
#

# ============================================
# DJANGO CONFIGURATION - PRODUCTION
# ============================================

# Django Debug Mode (MUST be False in production)
DEBUG=False

# Django Secret Key (Generate strong random key)
# Command: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# Example: qe1@k^=jy5*8#m$9xq2p0r&tuvwxyz123abc456def789
SECRET_KEY=your-production-secret-key-here

# Production Allowed Hosts (your Render domain)
# Example: trash-tracker-backend.onrender.com,localhost,127.0.0.1
ALLOWED_HOSTS=your-service.onrender.com,localhost

# ============================================
# DATABASE CONFIGURATION - PRODUCTION
# ============================================

# Option 1: SQLite (simple but not recommended for production)
# DATABASE_URL=sqlite:///db.sqlite3

# Option 2: PostgreSQL (recommended for production)
# First create database on Render or Heroku
# Example: postgresql://user:password@host:5432/database_name
# DATABASE_URL=postgresql://postgres:password@db.example.com:5432/trash_tracker

# ============================================
# CORS & API CONFIGURATION - PRODUCTION
# ============================================

# CORS Allowed Origins (your Vercel frontend URL)
# Example: https://trash-tracker-frontend.vercel.app,https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://trash-tracker-frontend.vercel.app

# ============================================
# SECURITY SETTINGS - PRODUCTION
# ============================================

# SSL/HTTPS Configuration (MUST be True for production)
SECURE_SSL_REDIRECT=True

# Cookie Security (MUST be True for production)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS Configuration (Optional but recommended)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================
# LOGGING - PRODUCTION
# ============================================

LOG_LEVEL=INFO

# ============================================
# EMAIL CONFIGURATION - PRODUCTION
# ============================================

# Option 1: Gmail
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-specific-password
# EMAIL_USE_TLS=True

# Option 2: SendGrid
# EMAIL_BACKEND=sendgrid_backend.SendgridBackend
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# Option 3: AWS SES
# EMAIL_BACKEND=django_ses.SESBackend
# AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
# AWS_SES_REGION_NAME=us-east-1
# AWS_SES_REGION_ENDPOINT=email.us-east-1.amazonaws.com

# ============================================
# MAP CONFIGURATION - PRODUCTION
# ============================================

MAP_CENTER_LAT=28.5355
MAP_CENTER_LNG=77.391
MAP_ZOOM=13

# ============================================
# APPLICATION FEATURES - PRODUCTION
# ============================================

ENABLE_ROUTE_OPTIMIZATION=True
ENABLE_REAL_TIME_UPDATES=True
ENABLE_ANALYTICS=True

# ============================================
# RENDER SPECIFIC SETTINGS
# ============================================

# Note: Render automatically sets PORT environment variable
# Use: gunicorn trash_tracker_backend.wsgi:application --bind 0.0.0.0:$PORT

# ============================================
# INSTRUCTIONS FOR PRODUCTION DEPLOYMENT
# ============================================

# 1. Generate Secret Key:
#    python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'

# 2. For Render Dashboard (Backend):
#    - Go to your service Settings
#    - Add these environment variables
#    - Change DEBUG to False
#    - Update ALLOWED_HOSTS with your Render domain
#    - Set CORS_ALLOWED_ORIGINS to your Vercel URL
#    - Set SECURE_SSL_REDIRECT=True
#    - Configure EMAIL if needed

# 3. For Vercel Dashboard (Frontend):
#    - Go to project Settings → Environment Variables
#    - Add API_BASE_URL pointing to your Render backend
#    - Example: https://trash-tracker-backend.onrender.com/api/

# 4. Database Migration on Render:
#    - After first deployment, run:
#    - render-cli exec web "python manage.py migrate"

# 5. Create Superuser on Render:
#    - render-cli exec web "python manage.py createsuperuser"

# 6. Monitor Deployment:
#    - Render: https://dashboard.render.com
#    - Vercel: https://vercel.com/dashboard
#    - GitHub Actions: https://github.com/Upendra48/Sankalan/actions

# ============================================
# COMMON PRODUCTION ISSUES & SOLUTIONS
# ============================================

# Issue: Database locked
# Solution: Use PostgreSQL instead of SQLite

# Issue: Static files not loading
# Solution: Ensure python manage.py collectstatic runs in build

# Issue: CORS errors
# Solution: Add Vercel URL to CORS_ALLOWED_ORIGINS

# Issue: SSL certificate errors
# Solution: Set SECURE_SSL_REDIRECT=True after SSL setup

# Issue: Slow deployments
# Solution: Optimize Docker image, use PostgreSQL

# ============================================
# PRODUCTION CHECKLIST
# ============================================

# Before deploying:
# [ ] Generate strong SECRET_KEY
# [ ] Set DEBUG=False
# [ ] Update ALLOWED_HOSTS
# [ ] Update CORS_ALLOWED_ORIGINS
# [ ] Set all SECURE_* settings to True
# [ ] Configure email backend
# [ ] Test migrations locally
# [ ] Test static files loading
# [ ] Update database (use PostgreSQL)
# [ ] Set up monitoring/logging
# [ ] Backup plan for data
# [ ] SSL certificate configured
# [ ] Performance optimizations done

# ============================================
