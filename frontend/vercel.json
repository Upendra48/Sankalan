{
  "framework": null,
  "installCommand": "bash setup_flutter.sh",
  "buildCommand": "export PATH=\"$PATH:$HOME/flutter/bin\" && flutter build web --release --dart-define=API_BASE_URL=https://sankalan.onrender.com/api",
  "outputDirectory": "build/web",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
