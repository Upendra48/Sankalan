# ============================================
# DJANGO CONFIGURATION
# ============================================

# Django Debug Mode (set to False for production)
DEBUG=True

# Django Secret Key (generate a strong random string)
# Command: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Database URL (for production with dj-database-url)
# DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL: postgresql://user:password@localhost:5432/trash_tracker
# DATABASE_URL=

# ============================================
# CORS & API CONFIGURATION
# ============================================

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:8000

# Frontend API Base URL (used by Flutter frontend)
# Development: http://127.0.0.1:8000/api/
# Production: https://your-app.onrender.com/api/
API_BASE_URL=http://127.0.0.1:8000/api/

# ============================================
# SECURITY SETTINGS
# ============================================

# SSL/HTTPS Configuration (set to True for production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server Port (for development)
PORT=8000

# Server Host
HOST=127.0.0.1

# ============================================
# STATIC FILES & MEDIA
# ============================================

# Static files URL
STATIC_URL=/static/

# Static files root directory
STATIC_ROOT=staticfiles/

# Media files URL
MEDIA_URL=/media/

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================

# Email Backend (for development use console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production email (Gmail, SendGrid, etc.)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True

# ============================================
# PAGINATION & API SETTINGS
# ============================================

# API Page Size
API_PAGE_SIZE=100

# ============================================
# MAP CONFIGURATION
# ============================================

# Default Map Center Latitude
MAP_CENTER_LAT=28.5355

# Default Map Center Longitude
MAP_CENTER_LNG=77.391

# Default Map Zoom Level
MAP_ZOOM=13

# ============================================
# APPLICATION FEATURES
# ============================================

# Enable Route Optimization
ENABLE_ROUTE_OPTIMIZATION=True

# Enable Real-time Updates
ENABLE_REAL_TIME_UPDATES=True

# Enable Analytics
ENABLE_ANALYTICS=True

# ============================================
# DEPLOYMENT ENVIRONMENTS
# ============================================

# For Render Deployment (Backend)
# DEBUG=False
# ALLOWED_HOSTS=your-service.onrender.com,localhost
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# For Vercel Deployment (Frontend)
# API_BASE_URL=https://your-service.onrender.com/api/

# ============================================
# GITHUB ACTIONS SECRETS (Do not add here)
# ============================================

# These are stored in GitHub repository secrets:
# - RENDER_SERVICE_ID
# - RENDER_DEPLOY_KEY
# - VERCEL_TOKEN
# - VERCEL_ORG_ID
# - VERCEL_PROJECT_ID

# ============================================
# INSTRUCTIONS FOR SETUP
# ============================================

# 1. Copy this file: cp .env.example .env
# 2. Update values in .env with your configuration
# 3. For production, generate a strong SECRET_KEY
# 4. Never commit .env file to Git
# 5. For deployment, set environment variables in Render/Vercel dashboards
